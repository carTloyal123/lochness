menu "Lochness keypad"

    config KEYPAD_FW_MAJOR
        int "Firmware major version"
        default 0
    config KEYPAD_FW_MINOR
        int "Firmware minor version"
        default 1

    menu "Button matrix (3 columns x 4 rows)"
        config KEYPAD_MATRIX
            bool "Enable 3x4 button matrix"
            default n
            help
                Layout:  1 2 3 / 4 5 6 / 7 8 9 / * 0 #
                Rows are driven low one at a time; columns are inputs with
                pull-ups. '*' clears, '#' unlocks.
        config KEYPAD_ROW0_GPIO
            int "Row 0 GPIO"
            depends on KEYPAD_MATRIX
            default 0
        config KEYPAD_ROW1_GPIO
            int "Row 1 GPIO"
            depends on KEYPAD_MATRIX
            default 1
        config KEYPAD_ROW2_GPIO
            int "Row 2 GPIO"
            depends on KEYPAD_MATRIX
            default 2
        config KEYPAD_ROW3_GPIO
            int "Row 3 GPIO"
            depends on KEYPAD_MATRIX
            default 3
        config KEYPAD_COL0_GPIO
            int "Column 0 GPIO"
            depends on KEYPAD_MATRIX
            default 4
        config KEYPAD_COL1_GPIO
            int "Column 1 GPIO"
            depends on KEYPAD_MATRIX
            default 5
        config KEYPAD_COL2_GPIO
            int "Column 2 GPIO"
            depends on KEYPAD_MATRIX
            default 6
    endmenu

    config KEYPAD_LOCK_BUTTON_GPIO
        int "Lock button GPIO (-1 = none)"
        range -1 30
        default -1
        help
            Dedicated one-touch lock button, active low.

    config KEYPAD_PAIR_BUTTON_GPIO
        int "Pair button GPIO (-1 = none; DevKitC BOOT button is GPIO 9)"
        range -1 30
        default 9
        help
            Hold for 3 seconds to enter pairing mode. On the production
            keypad this sits behind the mounting plate.

    config KEYPAD_STATUS_LED_GPIO
        int "Status RGB LED (WS2812) GPIO (-1 = none)"
        range -1 30
        default 8
        help
            The DevKitC-1's onboard RGB LED (GPIO 8): white while starting,
            blinking blue while pairing, amber when not paired, green when
            paired and ready. Bench aid; off on a battery keypad.

    config KEYPAD_STATUS_LED_BRIGHTNESS
        int "Status LED brightness (1-255)"
        range 1 255
        default 24

    config KEYPAD_LED_GREEN_GPIO
        int "Green LED GPIO (-1 = none)"
        range -1 30
        default -1
    config KEYPAD_LED_RED_GPIO
        int "Red LED GPIO (-1 = none)"
        range -1 30
        default -1
    config KEYPAD_BUZZER_GPIO
        int "Piezo buzzer GPIO (-1 = none)"
        range -1 30
        default -1

    menu "Battery sense"
        config KEYPAD_BATTERY_ADC_GPIO
            int "Battery divider ADC GPIO (-1 = none)"
            range -1 6
            default -1
            help
                ADC1 pin wired to the midpoint of a divider across the
                battery (ESP32-C6: GPIO 0-6). With -1 the keypad reports
                its battery as unknown (0 mV), as the DevKit has no
                divider. Use high-value resistors (for example 2 x 1 MOhm
                with 100 nF to GND) so the divider barely drains the cells.
        config KEYPAD_BATTERY_DIVIDER_PCT
            int "Battery voltage as a percentage of the ADC pin voltage"
            depends on KEYPAD_BATTERY_ADC_GPIO >= 0
            range 100 1000
            default 200
            help
                200 for a divider of two equal resistors.
        config KEYPAD_BATTERY_LOW_MV
            int "Low-battery threshold (mV)"
            depends on KEYPAD_BATTERY_ADC_GPIO >= 0
            default 2400
            help
                Below this the keypad sets the low-battery flag. 2400 mV
                suits 2 x AA lithium cells.
    endmenu

    comment "Capacitive touch keys: backend pending touch-controller selection"

endmenu
