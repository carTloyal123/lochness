# Prototype target: ESP32-C6-DevKitC-1. Production may move to ESP32-H2.
CONFIG_IDF_TARGET="esp32c6"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Development key. See components/platform_esp/Kconfig.
CONFIG_LOCHNESS_PIN_KEY_DEV_NVS=y

# Bluetooth LE (NimBLE): GATT server for keypad / hub / phone links
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# No BLE-layer bonding: links are secured by Noise at the app layer.
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="Lock"

# NimBLE logs every GATT procedure at INFO; at 115200 baud that delays the
# host task by milliseconds per step.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
