# Overlay for QEMU smoke tests (tools/qemu_console.sh): QEMU has no BT controller.
CONFIG_BT_ENABLED=n
# Paths in sdkconfig are relative to the project: qemu/ (see qemu/CMakeLists.txt).
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
# QEMU's ESP32-C3 has no WS2812 on the board.
CONFIG_LOCHNESS_STATUS_LED_GPIO=-1
