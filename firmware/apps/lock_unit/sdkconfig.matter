# Matter over Thread (esp-matter v1.6.1), layered on sdkconfig.defaults by
# CMakeLists.txt unless LOCHNESS_MATTER=OFF. Based on esp-matter's door_lock
# example (sdkconfig.defaults + .c6_thread), with its cluster exclusions.

# Thread, no Wi-Fi
CONFIG_OPENTHREAD_ENABLED=y
# End device, not a router: a battery lock must not route for the mesh, and a
# booting router's link setup with every neighbor router fills the channel
# (hundreds of CSMA "channel busy" waits in the first seconds). Rx stays on
# for now; sleepy end device (Matter ICD) comes with the power work.
CONFIG_OPENTHREAD_MTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_ENABLE_WIFI_STATION=n
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y

# BLE: Matter commissioning on advertising set 0, the keypad link on set 1
# (see main/ble_server.c). BLE stays up after commissioning for the keypad.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=70
# The link's 3 (LL_MAX_CONNS) plus one commissioning connection.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
# BLE name while commissioning: prefix + 4-digit discriminator (16 chars max).
CONFIG_BLE_DEVICE_NAME_PREFIX="Lochness-"

# Matter
# The lock's console owns the UART (lochness>); `matter ...` commands there.
CONFIG_ENABLE_CHIP_SHELL=n
# No OTA provider yet.
CONFIG_ENABLE_OTA_REQUESTOR=n
# Names and serial from main/device_info.cpp (menuconfig > Lochness lock unit > Matter).
CONFIG_CUSTOM_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_DEVICE_SOFTWARE_VERSION_NUMBER=1
CONFIG_DEFAULT_DEVICE_HARDWARE_VERSION=1
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_ESP_MATTER_NVS_USE_COMPACT_ATTR_STORAGE=y
CONFIG_MAX_GROUP_KEYS_PER_FABRIC=4
CONFIG_LIBSODIUM_USE_MBEDTLS_SHA=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# Exclude unused clusters to save flash and RAM
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
