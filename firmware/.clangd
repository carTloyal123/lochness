# clangd (editor) settings. Editor behaviour only: every lint rule lives in
# the .clang-tidy files, which clangd and tools/lint.sh both read, so the
# editor and the linter report the same findings. Don't add diagnostics or
# check settings here.
#
# Run clangd through tools/clangd so it is the same LLVM build as the linter.
# The database comes from tools/compile_db.py (tools/lint.sh refreshes it).
CompileFlags:
  # Pin the merged database; otherwise clangd would pick up each app's raw
  # ESP-IDF database (GCC flags clang cannot parse) from apps/*/build.
  CompilationDatabase: .
Diagnostics:
  ClangTidy:
    # Run every configured check as you type, not just the fast ones.
    FastCheckFilter: None
  # clangd's own include checker would be a second rule set with its own
  # ignore list; misc-include-cleaner in .clang-tidy covers it instead.
  UnusedIncludes: None
  MissingIncludes: None
Index:
  StandardLibrary: Yes
InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
Hover:
  ShowAKA: Yes
