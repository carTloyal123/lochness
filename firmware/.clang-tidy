---
# The single source of lint rules, for all of our code: clangd (editor) and
# tools/lint.sh (CLI/CI) both read it. The one other .clang-tidy is
# components/monocypher's, which turns vendored code off. Keep editor-only
# settings in .clangd and rules here.
#
# Every check is on and every finding is an error. The only removals are
# checks that cannot apply to this code base (they target another project or
# language, or fire inside a platform macro with no fix at the call site) and
# alias checks that would report the same finding twice; reasons below.
# Prefer fixing or NOLINT(check) with a reason over adding here.
#
#   altera-*      Intel FPGA OpenCL kernels.
#   llvmlibc-*    LLVM's own libc implementation (namespaces, entrypoint macros).
#   fuchsia-*     Google Fuchsia's house rules (no default arguments, no static
#                 objects, ...), which the Matter SDK's C++ API needs.
#   clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling
#                 Wants C11 Annex K memcpy_s/memset_s; picolibc and glibc lack
#                 it. Secret wiping is handled by sl_wipe / volatile loops.
#   modernize-use-nullptr (and its hicpp alias)
#                 ESP-IDF builds are C23, but the portable components are also
#                 built as C11 for the host tests, where nullptr doesn't exist.
#   readability-implicit-bool-conversion
#                 Written for C++. In C, ==, < and && yield int, so every
#                 `bool ok = a == b` and `return x && y` is flagged and the
#                 fixes add (int) casts and `!= 0` to correct code.
#   modernize-use-trailing-return-type
#                 A C++ style rewrite (`auto f() -> T`) at odds with the C
#                 conventions the rest of the code base follows.
#   cppcoreguidelines-avoid-magic-numbers
#                 Alias of readability-magic-numbers (same finding twice and
#                 a second copy of its options to keep in step).
#   hicpp-signed-bitwise
#                 ESP_LOGx expands to `(level) | ESP_LOG_CONFIGS_DEFAULT` on a
#                 signed enum, so it fires on every log call (and on NimBLE's
#                 flag macros); the operands are IDF's, not ours.
#   cppcoreguidelines-pro-type-vararg (and its hicpp alias)
#                 C++ only (the Matter glue): ESP_LOGx and printf are the
#                 platform's logging and console output.
#   cppcoreguidelines-pro-type-union-access
#                 C++ only: our protocol and the Matter SDK's event types are
#                 C tagged unions (lp_msg_t, ChipDeviceEvent), and ESP_LOGx
#                 expands to a union access.
Checks: >
  *,
  -altera-*,
  -llvmlibc-*,
  -fuchsia-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -modernize-use-nullptr,
  -hicpp-use-nullptr,
  -readability-implicit-bool-conversion,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-avoid-magic-numbers,
  -hicpp-signed-bitwise,
  -cppcoreguidelines-pro-type-vararg,
  -hicpp-vararg,
  -cppcoreguidelines-pro-type-union-access,
WarningsAsErrors: '*'
# Lint our headers, not ESP-IDF's or the vendored Monocypher. (Header
# filtering is clang-tidy's; clangd only reports on the open file.)
HeaderFilterRegex: '.*/firmware/(apps|components|test)/.*'
ExcludeHeaderFilterRegex: '.*/components/monocypher/.*'
FormatStyle: none
CheckOptions:
  # Naming: C conventions used throughout (lc_lock_t, lc_request, LC_MAX_USERS).
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.StructCase: lower_case
  readability-identifier-naming.UnionCase: lower_case
  readability-identifier-naming.EnumCase: lower_case
  readability-identifier-naming.TypedefCase: lower_case
  readability-identifier-naming.TypedefSuffix: _t
  readability-identifier-naming.EnumConstantCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
  readability-identifier-naming.StaticConstantCase: UPPER_CASE
  # Short names that are idiomatic in C: loop indices, contexts, buffers.
  readability-identifier-length.IgnoredVariableNames: '^(i|j|k|n|p|q|r|s|t|e|c|d|v|ok|rc|ev|hs|ll|lc|kp|rl|ck|ad|it|op|ms|id)$'
  readability-identifier-length.IgnoredParameterNames: '^(i|j|k|n|p|q|r|s|t|e|c|d|v|ok|ev|hs|ll|lc|kp|rl|ck|ad|op|ms|id|a|b|rs)$'
  # Powers of two (masks, sizes), 255 and 1000 (ms per s) read fine as literals.
  readability-magic-numbers.IgnoredIntegerValues: '0;1;2;3;255;1000'
  readability-magic-numbers.IgnorePowersOf2IntegerValues: true
  readability-function-cognitive-complexity.IgnoreMacros: true
  # ESP_LOGx and the CHIP macros are do { } while (0) inside; only flag ours.
  cppcoreguidelines-avoid-do-while.IgnoreMacros: true
  readability-function-size.LineThreshold: 120
  # Known cycles inside ESP-IDF (FreeRTOS.h <-> idf_additions.h, NimBLE's
  # ble_hs.h <-> ble_gap.h and os/) and the Matter SDK (esp_matter.h,
  # ConfigurationManager.h <-> its generic implementation).
  misc-header-include-cycle.IgnoredFilesList: 'FreeRTOS\.h;ble_hs\.h;ble_gap\.h;os_mbuf\.h;esp_matter\.h;ConfigurationManager\.h'
  bugprone-easily-swappable-parameters.MinimumLength: 3
  misc-include-cleaner.IgnoreHeaders: 'sys/_.*;machine/.*;sdkconfig\.h;freertos/.*;esp_.*\.h;host/.*;nimble/.*;services/.*'
...
